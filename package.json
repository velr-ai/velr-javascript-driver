{
  "name": "@velr-ai/velr",
  "version": "0.2.62",
  "description": "JavaScript and TypeScript bindings for Velr, an embedded openCypher graph database built on SQLite",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "require": "./dist/worker/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "QUERY_LANGUAGE.md",
    "API.md",
    "GUIDE.md",
    "LICENSE",
    "LICENSE.runtime"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsup && node scripts/public-declarations.mjs && npm run typecheck:public",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:api": "node scripts/api-reference.mjs",
    "docs:check": "node scripts/api-reference.mjs --check",
    "docs:examples:check": "node --test scripts/check-doc-examples.test.mjs && node scripts/check-doc-examples.mjs --inventory-only",
    "docs:test": "node scripts/check-doc-examples.mjs",
    "prebuild": "npm run docs:check",
    "pretest": "npm run docs:check",
    "typecheck:public": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext scripts/public-api-check.ts"
  },
  "dependencies": {
    "koffi": ">=2.11.0 <4"
  },
  "peerDependencies": {
    "apache-arrow": ">=15"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@velr-ai/runtime-darwin-arm64": "0.2.62",
    "@velr-ai/runtime-darwin-x64": "0.2.62",
    "@velr-ai/runtime-linux-x64-gnu": "0.2.62",
    "@velr-ai/runtime-linux-arm64-gnu": "0.2.62",
    "@velr-ai/runtime-win32-x64-msvc": "0.2.62"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "apache-arrow": "15.0.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "arrow",
    "cypher",
    "database",
    "embedded",
    "fulltext",
    "graph",
    "opencypher",
    "sqlite",
    "typescript",
    "vector"
  ],
  "homepage": "https://velr.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/velr-ai/velr-javascript-driver.git"
  },
  "bugs": {
    "url": "https://github.com/velr-ai/velr-javascript-driver/issues"
  }
}
